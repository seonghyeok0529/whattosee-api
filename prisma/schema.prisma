datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}
 
generator client {
  provider = "prisma-client-js"
}

enum SourceSide {
  left
  center
  right
  neutral
}

enum ArticleStatus {
  FETCHED
  PARSED
  EMBEDDED
  CLUSTERED
  ATTACHED
  FAILED
}

enum ParentType {
  issue
  agenda
  clipIssue
}

enum Stance {
  agree
  neutral
  disagree
}

enum Role {
  user
  admin
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum IssueRelationKind {
  RELATED    // 일반 연관
  EPISODE_OF // 상·하위 관계 (원 이슈 ↔ 파생 이슈)
}

enum IssueStatus {
  SUGGESTED  // 추천됨 / 자동 생성됨
  DRAFT      // 관리자 편집 중
  PUBLISHED  // 사용자에게 공개
  ARCHIVED   // 숨김(폐기)
}

enum UserStatus {
  ACTIVE // 활성
  SUSPENDED // 정지
}

// 커뮤니티 라운지 (프론트의 CommunityLounge와 값 일치)
enum CommunityLounge {
  popular       // ❗ 실제 post.lounge 값으로 쓰진 않고, "전체 인기" 필터용으로만 사용
  politics
  society
  economy
  international
  tech
  culture
  daily
  humor
}

// 관련 이슈 링크 타입
enum LinkedIssueType {
  article   // Issue
  clip      // ClipIssue
}

model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  username      String?
  nickname      String?
  
  kakaoId       String?        @unique
  naverId       String?        @unique
  googleId      String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[] // Account.user <-> User.accounts
  refreshTokens RefreshToken[] // RefreshToken.user <-> User.refreshTokens

  bio             String? // 한 줄 소개
  interests       Json?
  tosAgreedAt     DateTime?
  privacyAgreedAt DateTime?
  marketingAgreed Boolean?  @default(false)

  ctiType   String?
  ctiScores Json?

  irtType      String?
  irtScores    Json?
  irtAnswers   Json?
  irtMeta      Json?
  irtUpdatedAt DateTime?

  gender        Gender?   // Kakao/Naver 프로필 → MALE/FEMALE/UNKNOWN
  birthYear     Int?      // 1997 같이 연도만
  ageRange      String?   // "20-29", "30-39" 처럼 provider 원본 그대로 저장해도 됨

  regionLevel1  String?  // 시
  regionLevel2  String?  // 군,구

  agendas     Agenda[]
  comments    AgendaComment[]
  likes       AgendaLike[]
  CommentLike CommentLike[]

  votes             Vote[] // Vote.user <-> User.votes
  issueComments     IssueComment[] // IssueComment.user <-> User.issueComments
  issueCommentLikes IssueCommentLike[] @relation("UserIssueCommentLikes")

  clipIssueComments     ClipIssueComment[]
  clipIssueCommentLikes ClipIssueCommentLike[]

  commentReports CommentReport[]

  communityPosts         CommunityPost[]        @relation("UserCommunityPosts")
  communityPostComments  CommunityPostComment[] @relation("UserCommunityPostComments")
  communityPostLikes     CommunityPostLike[]    @relation("UserCommunityPostLikes")

  // 🔥 열람 로그
  articleViewLogs  ArticleViewLog[]
  newsClipViewLogs NewsClipViewLog[]

  eventLogs EventLog[]

  role      Role       @default(user)
  isAdmin   Boolean    @default(false)
  status    UserStatus @default(ACTIVE)
}

model EventLog {
  id        String   @id @default(cuid())

  // 🔹 기본 식별 정보
  eventType String   // 예: "issue_click", "page_view", "tab_change" ...
  sessionId String   // 프론트에서 sid로 보내는 값
  userId    String?  // 로그인 된 경우만 채움

  // 🔹 페이지 / 섹션 / 이슈 관련
  pagePath   String? // location.pathname
  section    String? // "media" | "user" | ...
  issueId    String?
  issueTitle String?

  // 🔹 스냅샷 (이 시점의 유저 상태)
  ctiTypeSnapshot        String?
  regionLevel1Snapshot   String?
  regionLevel2Snapshot   String?

  // 🔹 기술 정보
  userAgent String?
  ipHash    String?   // 원본 IP 대신 해시(선택)

  // 🔹 원본 payload 전체 (안전망 + 미래용)
  payload   Json

  createdAt DateTime @default(now())

  // 🔹 관계
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([issueId, createdAt])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String // 'google' | 'kakao' | 'naver' | 'apple'
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])
}

model PageView {
  id         String     @id @default(cuid())
  parentType ParentType
  parentId   String

  userId     String?    // 로그인 사용자면 채움
  sessionId  String?    // 익명/로그인 공통 식별 (쿠키로 발급)
  ipHash     String?    // (선택) 프록시/봇 탐지·보조용
  userAgent  String?    // (선택)

  dayKey     String     // YYYY-MM-DD (하루 중복 방지 키)
  createdAt  DateTime   @default(now())

  @@index([parentType, parentId, dayKey])
  @@unique([parentType, parentId, sessionId, dayKey], map: "uniq_view_per_day_by_session")
}

// 🔥 기사 열람 로그: 특정 Source(언론 기사) 기준
model ArticleViewLog {
  id        String     @id @default(cuid())
  userId    String
  sourceId  String
  side      SourceSide
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceId])
}

model Agenda {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  title        String
  content      String
  tags         Json?
  likesCount   Int      @default(0)
  commentCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  comments      AgendaComment[] @relation("Agenda_Comments")
  likes         AgendaLike[]
  commentLikes  CommentLike[]
  bestCommentId String?         @unique
  bestComment   AgendaComment?  @relation("Agenda_BestComment", fields: [bestCommentId], references: [id])

  @@index([title])
  @@index([createdAt])
  @@index([likesCount, commentCount])
}

model AgendaComment {
  id        String   @id @default(cuid())
  agendaId  String
  agenda    Agenda   @relation("Agenda_Comments", fields: [agendaId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  reportedCount Int       @default(0)

  likedBy CommentLike[]
  bestFor Agenda?       @relation("Agenda_BestComment")
}

model AgendaLike {
  userId    String
  agendaId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  agenda Agenda @relation(fields: [agendaId], references: [id])

  @@id([userId, agendaId])
  @@index([agendaId])
}

model CommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id])
  comment  AgendaComment @relation(fields: [commentId], references: [id])
  Agenda   Agenda?       @relation(fields: [agendaId], references: [id])
  agendaId String?

  @@id([userId, commentId])
  @@index([commentId])
}

model Issue {
  id        String   @id @default(uuid())
  title     String
  summary   String?
  tags      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  leftSummary  String?
  rightSummary String?
  thumbnailUrl String?
  glossaryText String?

  dedupKey String? @unique

  body    String?
  sources Source[]
  persons PersonRef[]

  comments           IssueComment[] // IssueComment.issue <-> Issue.comments
  clusterSuggestions ClusterSuggestion[] @relation(name: "IssueToClusterSuggestions")

  status IssueStatus @default(SUGGESTED)

  relatedFrom IssueRelation[] @relation("IssueRelationFrom")
  relatedTo   IssueRelation[] @relation("IssueRelationTo")

  communityLinks CommunityPostIssueLink[] @relation("IssueCommunityLinks")

  // 🔥 새 컨텐츠 모듈
  talkingPoints IssueTalkingPoint[]
  sensemaking   IssueSensemaking?

  frameGroupCache IssueFrameGroupCache?
}

model IssueYoutubeIngest {
  id           String   @id @default(cuid())
  clipIssueId  String
  clipIssue    ClipIssue @relation(fields: [clipIssueId], references: [id], onDelete: Cascade)
  fetchedAt    DateTime
  params       Json
  videoCount   Int
  commentCount Int
  createdAt    DateTime @default(now())

  @@index([clipIssueId, fetchedAt])
}

model IssueYoutubeAnalyticsCache {
  id          String   @id @default(cuid())
  clipIssueId String   @unique
  clipIssue   ClipIssue @relation(fields: [clipIssueId], references: [id], onDelete: Cascade)
  payload     Json
  generatedAt DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model IssueFrameGroupCache {
  id          String   @id @default(cuid())
  issueId     String   @unique
  payload     Json
  model       String
  attempts    Int
  articleCount Int
  generatedAt DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model IssueRelation {
  id           String   @id @default(cuid())
  fromIssueId  String
  toIssueId    String
  relationType String?  // 예: "RELATED" | "CONTINUATION" | "DUPLICATE"
  confidence   Float?   // 0~1 추천 점수 (선택)
  createdAt    DateTime @default(now())

  from Issue @relation("IssueRelationFrom", fields: [fromIssueId], references: [id], onDelete: Cascade)
  to   Issue @relation("IssueRelationTo",   fields: [toIssueId],   references: [id], onDelete: Cascade)

  @@unique([fromIssueId, toIssueId])
  @@index([toIssueId])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  userId    String? // 익명 댓글 허용 시 nullable
  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  reportedCount Int       @default(0)

  issue Issue @relation(fields: [issueId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  // ✅ 이 이름과 아래 IssueCommentLike.comment 의 relation 이름이 정확히 일치해야 함
  likedBy IssueCommentLike[] @relation("IssueCommentLikes")

  @@index([issueId, createdAt])
}

model IssueCommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())

  // ✅ 관계 이름 일치 (User 쪽과 "UserIssueCommentLikes", IssueComment 쪽과 "IssueCommentLikes")
  user    User         @relation("UserIssueCommentLikes", fields: [userId], references: [id], onDelete: Cascade)
  comment IssueComment @relation("IssueCommentLikes", fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId]) // 유저당 한 번만
  @@index([commentId])
}

model CommentReport {
  id         String     @id @default(cuid())
  parentType ParentType
  commentId  String
  userId     String
  reason     String?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([parentType, commentId, userId], name: "report_unique_triplet") // 같은 유저의 중복 신고 방지
  @@index([parentType, commentId])
}

model Source {
  id        String     @id @default(uuid())
  issueId   String
  issue     Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  outlet    String
  title     String
  url       String     @unique
  side      SourceSide
  createdAt DateTime   @default(now())

  suggestionArticles ClusterSuggestionArticle[] @relation(name: "SourceToSuggestionArticles")

  // 🔥 기사 열람 로그 역참조
  articleViewLogs ArticleViewLog[]
}

model PersonRef {
  id      String  @id @default(uuid())
  issueId String
  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  name    String
  role    String?
}

model RawArticle {
  id          String        @id @default(uuid())
  outlet      String
  side        SourceSide
  url         String        @unique
  title       String
  publishedAt DateTime?
  html        String?
  text        String?
  hash        String
  embedding   Bytes?
  status      ArticleStatus @default(FETCHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  clusterKey  String?
  thumbnail   String?

  suggestionArticles ClusterSuggestionArticle[] @relation(name: "RawToSuggestionArticles")

  @@index([status])
  @@index([clusterKey])
}

enum ClusterSuggestionStatus {
  PENDING // 대기(검수 전)
  APPROVED // 확정(이슈로 승격)
  REJECTED // 기각
  MERGED // 다른 제안과 병합됨
  SPLIT // 쪼개짐
}

model Vote {
  id         String     @id @default(cuid())
  parentType ParentType
  parentId   String
  userId     String?
  sessionId  String?
  ctiType    String?
  stance     Stance
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@unique([parentType, parentId, userId])
  @@unique([parentType, parentId, sessionId])
  @@index([parentType, parentId])
}

model ClusterSuggestion {
  id          String                  @id @default(cuid())
  key         String                  @unique
  title       String
  summary     String?
  confidence  Float
  windowStart DateTime?
  windowEnd   DateTime?
  status      ClusterSuggestionStatus @default(PENDING)

  // 관계
  articles ClusterSuggestionArticle[]
  issue    Issue?                     @relation(name: "IssueToClusterSuggestions", fields: [issueId], references: [id], onDelete: SetNull)
  issueId  String?

  articlesCount      Int      @default(0)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ClusterDecisionLog ClusterDecisionLog[]

  @@index([status, createdAt])
  @@index([issueId])
}

model ClusterSuggestionArticle {
  id String @id @default(cuid())

  // ↔ ClusterSuggestion (필수)
  suggestion   ClusterSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  suggestionId String

  // 원본 매핑(있으면 연결, 없으면 스냅샷 필드 사용)
  raw          RawArticle? @relation(name: "RawToSuggestionArticles", fields: [rawArticleId], references: [id], onDelete: SetNull)
  rawArticleId String?

  source   Source? @relation(name: "SourceToSuggestionArticles", fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId String?

  // 스냅샷
  url         String
  title       String?
  outlet      String?
  side        SourceSide?
  publishedAt DateTime?
  summary     String?

  createdAt DateTime @default(now())

  @@unique([suggestionId, url])
  @@index([rawArticleId])
  @@index([sourceId])
}

// 관리자 행동 로그(학습 데이터)
model ClusterDecisionLog {
  id           String   @id @default(cuid())
  suggestionId String
  action       String // APPROVE | REJECT | MERGE | SPLIT | MOVE
  detail       Json?
  createdAt    DateTime @default(now())

  suggestion ClusterSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
}

model RawClip {
  id          String      @id @default(cuid())
  youtubeId   String      @unique
  title       String
  description String?
  channel     String
  side        SourceSide  // 기존 enum 재사용 (left/center/right/neutral)
  url         String      @unique
  thumbnail   String?
  publishedAt DateTime?
  text        String?     // 자막/설명/요약 등을 합친 텍스트
  embedding   Bytes?
  status      ArticleStatus @default(FETCHED) // 기존 enum 그냥 재사용해도 됨
  clusterKey  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  duration    String?       // 유튜브에서 가져온 재생시간

  suggestions ClipClusterSuggestionItem[]

  clipLinks   ClipIssueClip[]

  // 🔥 뉴스 클립 열람 로그 역참조
  viewLogs    NewsClipViewLog[]

  @@index([status])
  @@index([clusterKey])
}

enum ClipClusterStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClipClusterSuggestion {
  id          String            @id @default(cuid())
  key         String            @unique
  title       String
  summary     String?
  confidence  Float
  windowStart DateTime?
  windowEnd   DateTime?
  status      ClipClusterStatus @default(PENDING)

  items       ClipClusterSuggestionItem[]

  clipIssue   ClipIssue? @relation("ClipClusterToClipIssue", fields: [clipIssueId], references: [id], onDelete: SetNull)
  clipIssueId String?    @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClipClusterSuggestionItem {
  id String @id @default(cuid())

  suggestion   ClipClusterSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  suggestionId String

  rawClip   RawClip? @relation(fields: [rawClipId], references: [id], onDelete: SetNull)
  rawClipId String?

  // 스냅샷
  youtubeId   String
  url         String
  title       String?
  channel     String?
  side        SourceSide?
  publishedAt DateTime?
  summary     String?

  createdAt DateTime @default(now())

  @@unique([suggestionId, youtubeId])
}

model ClipIssue {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  thumbnail   String?
  isHot       Boolean  @default(false)

  aiSummary          String?
  progressiveSummary String?  // 진보 성향 클립 요약
  conservativeSummary String? // 보수 성향 클립 요약
  glossaryText        String?

  clipCount   Int      @default(0)
  totalViews  Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments    ClipIssueComment[]
  clips       ClipIssueClip[]

  communityLinks    CommunityPostIssueLink[] @relation("ClipIssueCommunityLinks")
  clusterSuggestion ClipClusterSuggestion?   @relation("ClipClusterToClipIssue")

  // 🔥 뉴스 클립 열람 로그 역참조
  viewLogs    NewsClipViewLog[]

  relatedFrom ClipIssueRelation[] @relation("ClipIssueRelationFrom")
  relatedTo   ClipIssueRelation[] @relation("ClipIssueRelationTo")

  // 필요하면 pageView도 ParentType = clipIssue로 재사용 가능

  // 🔥 새 컨텐츠 모듈
  talkingPoints ClipIssueTalkingPoint[]
  sensemaking   ClipIssueSensemaking?
  youtubeIngests  IssueYoutubeIngest[]
  youtubeAnalyticsCache IssueYoutubeAnalyticsCache?
}

model ClipIssueRelation {
  id              String   @id @default(cuid())
  fromClipIssueId String
  toClipIssueId   String
  relationType    String?  // 예: "RELATED" | "FOLLOW_UP" 등 (지금은 안 써도 됨)
  confidence      Float?   // 0~1 추천 점수 (선택)
  createdAt       DateTime @default(now())

  from ClipIssue @relation("ClipIssueRelationFrom", fields: [fromClipIssueId], references: [id], onDelete: Cascade)
  to   ClipIssue @relation("ClipIssueRelationTo",   fields: [toClipIssueId],   references: [id], onDelete: Cascade)

  @@unique([fromClipIssueId, toClipIssueId])
  @@index([toClipIssueId])
}

model ClipIssueComment {
  id          String   @id @default(cuid())
  clipIssueId String
  clipIssue   ClipIssue @relation(fields: [clipIssueId], references: [id])

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  reportedCount Int       @default(0)

  likedBy ClipIssueCommentLike[]

  @@index([clipIssueId, createdAt])
}

model ClipIssueCommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id])
  comment ClipIssueComment @relation(fields: [commentId], references: [id])

  @@id([userId, commentId])
  @@index([commentId])
}

model ClipIssueClip {
  id          String     @id @default(cuid())
  clipIssueId String
  rawClipId   String
  side        SourceSide  // left / center / right / neutral

  clipIssue   ClipIssue  @relation(fields: [clipIssueId], references: [id], onDelete: Cascade)
  rawClip     RawClip    @relation(fields: [rawClipId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())

  @@unique([clipIssueId, rawClipId])
  @@index([rawClipId])
}

// 🔥 뉴스 클립 열람 로그: 진보/공영/보수 그룹 기준
model NewsClipViewLog {
  id          String   @id @default(cuid())
  userId      String
  clipIssueId String?
  rawClipId   String?
  // "progressive" | "public" | "conservative"
  group       String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clipIssue ClipIssue? @relation(fields: [clipIssueId], references: [id], onDelete: SetNull)
  rawClip   RawClip?   @relation(fields: [rawClipId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clipIssueId])
  @@index([rawClipId])
}

model CommunityPost {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation("UserCommunityPosts", fields: [userId], references: [id])

  lounge       CommunityLounge  // politics, society, ... (popular는 직접 안 씀)
  title        String
  content      String
  thumbnail    String?
  images       Json?        // ["https://.../1.png", "https://.../2.jpg"]
  poll         CommunityPostPoll?    // 1:1

  likesCount   Int              @default(0)
  commentCount Int              @default(0)
  viewsCount   Int              @default(0)
  isHot        Boolean          @default(false)
  isAnonymous  Boolean          @default(false)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  comments     CommunityPostComment[]
  links        CommunityPostIssueLink[]
  likes        CommunityPostLike[] @relation("PostCommunityPostLikes")

  @@index([lounge, createdAt])
  @@index([lounge, likesCount, commentCount])
}

model CommunityPostComment {
  id        String   @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?    @relation("UserCommunityPostComments", fields: [userId], references: [id])

  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  isAnonymous  Boolean  @default(false)

  isDeleted Boolean  @default(false)

  @@index([postId, createdAt])
}

model CommunityPostIssueLink {
  id          String        @id @default(cuid())
  postId      String
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  kind        LinkedIssueType

  // 🔹 인터넷 기사 이슈
  issueId     String?
  issue       Issue?        @relation("IssueCommunityLinks", fields: [issueId], references: [id])

  // 🔹 뉴스 클립 이슈
  clipIssueId String?
  clipIssue   ClipIssue?    @relation("ClipIssueCommunityLinks", fields: [clipIssueId], references: [id])

  @@index([postId])
  @@index([issueId])
  @@index([clipIssueId])
}

model CommunityPostPoll {
  id        String   @id @default(cuid())
  postId    String   @unique
  post      CommunityPost @relation(fields: [postId], references: [id])

  question  String
  // options: [{ id: "1", label: "떡볶이" }, ...]
  options   Json
  createdAt DateTime @default(now())
  closedAt  DateTime?

  votes     CommunityPostPollVote[] @relation("CommunityPostPollVotes")
}

model CommunityPostPollVote {
  id        String   @id @default(cuid())
  pollId    String
  poll      CommunityPostPoll @relation("CommunityPostPollVotes", fields: [pollId], references: [id])

  userId    String?
  sessionId String?      // 로그인 안 한 사람 구분용(optional)
  optionId  String

  createdAt DateTime @default(now())

  @@index([pollId])
  @@unique([pollId, userId])
  @@unique([pollId, sessionId])
}

model CommunityPostLike {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User          @relation("UserCommunityPostLikes", fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation("PostCommunityPostLikes", fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

/* ─────────────────────────────────────────
   새로 추가된 컨텐츠 모델들
   - 쟁점 리스트 (Issue / ClipIssue)
   - 센스메이킹 패널 (Issue / ClipIssue)
───────────────────────────────────────── */

model IssueTalkingPoint {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  order     Int      // 노출 순서 (1,2,3...)
  title     String   // 쟁점 한 줄 제목
  body      String   // 관찰 포인트 중심 설명
  kind      String?  // 예: "policy", "value_conflict", "procedure" 등

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId, order])
}

model ClipIssueTalkingPoint {
  id          String   @id @default(cuid())
  clipIssueId String
  clipIssue   ClipIssue @relation(fields: [clipIssueId], references: [id], onDelete: Cascade)

  order       Int
  title       String
  body        String
  kind        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clipIssueId, order])
}

model IssueSensemaking {
  id        String   @id @default(cuid())
  issueId   String   @unique
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  importance      Int       // 1~5
  impactAreas     String[]  // ["경제", "복지"] 등
  difficultyLevel String?   // 예: "BEGINNER" | "INTERMEDIATE" | "ADVANCED"

  whyImportant   String     // 왜 중요한지
  everydayImpact String?    // 일상 영향

  keyQuestions   String[]   // 스스로 생각해볼 질문들

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClipIssueSensemaking {
  id          String   @id @default(cuid())
  clipIssueId String   @unique
  clipIssue   ClipIssue @relation(fields: [clipIssueId], references: [id], onDelete: Cascade)

  importance      Int
  impactAreas     String[]
  difficultyLevel String?

  whyImportant   String
  everydayImpact String?

  keyQuestions   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobLock {
  key         String   @id
  lockedUntil DateTime
  runId       String?
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
}
model YoutubeChannelCursor {
  channelId       String   @id
  lastPublishedAt DateTime?
  updatedAt       DateTime @updatedAt

  @@index([lastPublishedAt])
}
